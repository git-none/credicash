# KREDI+ BACKEND 1.1.2 - RAILWAY (ACTUALIZACION DEL SERVICIO EXISTENTE)
# ------------------------------------------------------------
# Si el servicio ya existe en Railway, NO crees otro PostgreSQL. Conserva la referencia
# DATABASE_URL actual hacia la misma base y mantén JWT_SECRET sin cambios.
# Este valor es solo un ejemplo local: nunca guardes credenciales reales aquí.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/BASE_DE_DATOS

# Railway inyecta PORT y RAILWAY_PUBLIC_DOMAIN automáticamente.
# Para desarrollo local se usa 8080. No fijes PORT en Railway.
PORT=8080

# Opcional. Déjalo vacío para usar https://RAILWAY_PUBLIC_DOMAIN automáticamente.
# Defínelo solo si usarás un dominio personalizado. No agregues /api/v1.
PUBLIC_BASE_URL=

# Sesiones. Recomendado: define una clave aleatoria de al menos 32 bytes y mantenla estable.
# Compatibilidad Railway existente: si JWT_SECRET queda vacío, Kredi+ genera una clave segura
# una sola vez en el volumen persistente y la reutiliza en los siguientes reinicios/despliegues.
JWT_SECRET=
JWT_SECRET_FILE=/data/.kredi-secrets/jwt-secret
REQUIRE_STABLE_JWT_SECRET=true
JWT_ISSUER=credicash
JWT_AUDIENCE=credicash-android
JWT_ACCESS_TOKEN_TTL_MINUTES=60
PERSISTENT_SESSION_TTL_DAYS=30

# Orígenes web autorizados, separados por coma. En Railway, si queda vacío, CORS no acepta navegadores externos.
# Las aplicaciones móviles nativas no dependen de CORS.
CORS_ALLOWED_ORIGINS=

# Protección previa a autenticación por dirección de red y acción.
AUTH_RATE_LIMIT_MAX_REQUESTS=12
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
REGISTRATION_RATE_LIMIT_MAX_REQUESTS=5
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=600

# Mantén desactivada la integración bancaria hasta configurar un proveedor real.
BANK_INTEGRATION_ENABLED=false

# PostgreSQL / rendimiento para el plan pequeño (512 MB)
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=300000
DB_MAX_LIFETIME_MS=1500000
DB_KEEPALIVE_TIME_MS=120000
DB_LEAK_DETECTION_THRESHOLD_MS=0
SERVER_CONNECTION_THREADS=1
SERVER_WORKER_THREADS=2
SERVER_CALL_THREADS=8

# Archivos subidos. En Railway conecta un volumen persistente montado en /data.
UPLOAD_DIR=/data/uploads

# reCAPTCHA
RECAPTCHA_REQUIRED=true
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Firebase (elige uno de los métodos actuales)
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Respaldo BCV opcional. Si queda vacío se usa DolarApi + caché local.
BCV_BACKUP_API_URL=

# Cuenta Contador de primera instalación. Solo se usa si aún no existe un Contador.
BOOTSTRAP_ACCOUNTANT_USERNAME=CONTADOR
BOOTSTRAP_ACCOUNTANT_EMAIL=
BOOTSTRAP_ACCOUNTANT_PASSWORD=
BOOTSTRAP_ACCOUNTANT_PIN=
BOOTSTRAP_ACCOUNTANT_NAME=Contador General
BOOTSTRAP_ACCOUNTANT_PHONE=
BOOTSTRAP_ACCOUNTANT_BIRTH_DATE=1990-01-01
ACCOUNTANT_INITIAL_BUDGET_USD=1000000
